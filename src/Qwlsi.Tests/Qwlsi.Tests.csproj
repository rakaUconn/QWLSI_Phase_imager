    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="intelmkl.redist.win-x64" Version="2026.1.0.226" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Qwlsi.Core\Qwlsi.Core.csproj" />
    <ProjectReference Include="..\Qwlsi.Camera\Qwlsi.Camera.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="data\python_zernike_order10.json" CopyToOutputDirectory="PreserveNewest" Link="data\python_zernike_order10.json" />
    <None Include="data\calibration_python_original.json" CopyToOutputDirectory="PreserveNewest" Link="data\calibration_python_original.json" />
  </ItemGroup>

