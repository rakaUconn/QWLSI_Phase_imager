<UserControl x:Class="Qwlsi.App.Controls.Surface3DView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hx="http://helix-toolkit.org/wpf/SharpDX">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border BorderBrush="{StaticResource Border}" BorderThickness="1">
            <Grid>
                <hx:Viewport3DX x:Name="Vp" BackgroundColor="#FF20252B" ShowCoordinateSystem="False" ShowViewCube="False" EnableMouseButtonHitTest="False" IsViewCubeEdgeClicksEnabled="False" EnableSwapChainRendering="True"
                                MSAA="Four" FXAALevel="None" CameraRotationMode="Trackball" ZoomExtentsWhenLoaded="False"
                                UseDefaultGestures="True" EnableDesignModeRendering="False"/>
                <TextBlock x:Name="Message" Foreground="#C8D0D8" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" Margin="30"
                           Text="No result yet — process a frame on the Offline tab"/>
                <TextBlock x:Name="RendererText" Foreground="#9AA4AE" FontFamily="Consolas" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,6"/>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="0,6,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="MinText" Style="{StaticResource Mono}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <Image x:Name="Bar" Grid.Column="1" Height="14" Stretch="Fill"/>
            <TextBlock x:Name="MaxText" Grid.Column="2" Style="{StaticResource Mono}" VerticalAlignment="Center" Margin="6,0,0,0"/>
            <TextBlock x:Name="UnitText" Grid.Column="3" Style="{StaticResource Label}" Margin="8,0,0,0" Text="nm (OPD)"/>
        </Grid>
    </Grid>
</UserControl>
