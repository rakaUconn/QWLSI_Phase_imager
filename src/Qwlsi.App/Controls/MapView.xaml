<UserControl x:Class="Qwlsi.App.Controls.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" BorderBrush="{StaticResource Border}" BorderThickness="1" Background="#1E1E1E">
            <Grid>
                <ScrollViewer x:Name="Scroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#1E1E1E"
                              PreviewMouseWheel="OnWheel" SizeChanged="OnViewportSized">
                    <Image x:Name="Img" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" MouseMove="OnMove" MouseLeave="OnLeave"
                           MouseLeftButtonDown="OnDown" MouseLeftButtonUp="OnUp" SnapsToDevicePixels="True">
                        <Image.LayoutTransform><ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1"/></Image.LayoutTransform>
                    </Image>
                </ScrollViewer>
                <TextBlock x:Name="Empty" Text="No result yet — open a frame and press Process" Foreground="#9AA" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                <TextBlock x:Name="Readout" Style="{StaticResource Mono}" Foreground="White" Background="#99000000" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6">
                    <Button Content="Fit" Click="OnFit" Padding="8,1" MinHeight="22"/>
                    <Button Content="1:1" Click="On11" Padding="8,1" MinHeight="22"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="0,6,0,0" x:Name="BarGrid">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="MinText" Grid.Column="0" Style="{StaticResource Mono}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <Image x:Name="Bar" Grid.Column="1" Height="14" Stretch="Fill"/>
            <TextBlock x:Name="MaxText" Grid.Column="2" Style="{StaticResource Mono}" VerticalAlignment="Center" Margin="6,0,0,0"/>
            <TextBlock x:Name="UnitText" Grid.Column="3" Style="{StaticResource Label}" Margin="8,0,0,0"/>
        </Grid>
    </Grid>
</UserControl>
