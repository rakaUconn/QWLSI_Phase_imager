<Application x:Class="Qwlsi.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Qwlsi.App"
             xmlns:core="clr-namespace:Qwlsi.Core;assembly=Qwlsi.Core"
             Startup="OnStartup">
    <Application.Resources>
        <local:UnitNameConverter x:Key="UnitName"/>
        <DataTemplate DataType="{x:Type core:Units}"><TextBlock Text="{Binding Converter={StaticResource UnitName}}"/></DataTemplate>
        <local:InvBoolConverter x:Key="InvBool"/>
        <local:BoolIndexConverter x:Key="BoolIndex"/>
        <SolidColorBrush x:Key="Accent" Color="#2F6DB5"/>
        <SolidColorBrush x:Key="PanelBg" Color="#F4F6F9"/>
        <SolidColorBrush x:Key="Border" Color="#C9D0DA"/>
        <SolidColorBrush x:Key="WarnBg" Color="#FFF4D6"/>

        <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/></Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="MinHeight" Value="26"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="6"/><Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,2"/></Style>
        <Style TargetType="RadioButton"><Setter Property="Margin" Value="0,2"/></Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="3,2"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style x:Key="Label" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Foreground" Value="#444"/></Style>
        <Style x:Key="Mono" TargetType="TextBlock"><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="12"/></Style>
    </Application.Resources>
</Application>
