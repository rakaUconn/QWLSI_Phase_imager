<Window x:Class="Qwlsi.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Qwlsi.App.Controls"
        xmlns:vm="clr-namespace:Qwlsi.App.ViewModels"
        Title="QWLSI single-frame wavefront — offline" Width="1500" Height="920" MinWidth="1100" MinHeight="700" Background="White">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <TabControl x:Name="Tabs" Grid.Row="0" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}" Margin="6,6,6,0">

            <!-- ============================================================ OFFLINE -->
            <TabItem Header="Offline" FontSize="14">
                <Grid Margin="8" DataContext="{Binding Offline}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="380"/><ColumnDefinition Width="*"/><ColumnDefinition Width="370"/></Grid.ColumnDefinitions>

                    <!-- left: files, mode, run -->
                    <DockPanel Grid.Column="0" Margin="0,0,10,0" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                            <Button Content="Open file(s)…" Command="{Binding OpenFilesCommand}"/>
                            <Button Content="Open folder…" Command="{Binding OpenFolderCommand}"/>
                            <Button Content="Clear" Command="{Binding ClearListCommand}"/>
                        </StackPanel>
                        <CheckBox DockPanel.Dock="Top" Content="include subfolders" IsChecked="{Binding IncludeSubfolders}" Margin="0,4,0,4"/>
                        <StackPanel DockPanel.Dock="Bottom">
                            <GroupBox Header="Reference">
                                <StackPanel>
                                    <RadioButton Content="Without reference (uses calibration.json)" IsChecked="{Binding WithReference, Converter={StaticResource InvBool}}" GroupName="mode"/>
                                    <StackPanel Margin="18,0,0,4">
                                        <TextBlock Text="optional system wavefront to subtract (.npy):" Foreground="#555" FontSize="12"/>
                                        <DockPanel><Button DockPanel.Dock="Right" Content="…" Padding="6,0" Command="{Binding BrowseSystemWavefrontCommand}" Margin="4,0,0,0"/>
                                            <Button DockPanel.Dock="Right" Content="✕" Padding="6,0" Command="{Binding ClearSystemWavefrontCommand}" Margin="4,0,0,0"/>
                                            <TextBox Text="{Binding SystemWavefrontPath, Mode=OneWay}" IsReadOnly="True" FontSize="11"/></DockPanel>
                                    </StackPanel>
                                    <RadioButton Content="With reference (flat frame; sample-only OPD)" IsChecked="{Binding WithReference}" GroupName="mode"/>
                                    <DockPanel Margin="18,2,0,0"><Button DockPanel.Dock="Right" Content="…" Padding="6,0" Command="{Binding BrowseReferenceCommand}" Margin="4,0,0,0"/>
                                        <Button DockPanel.Dock="Right" Content="✕" Padding="6,0" Command="{Binding ClearReferenceCommand}" Margin="4,0,0,0"/>
                                        <TextBox Text="{Binding ReferencePath, Mode=OneWay}" IsReadOnly="True" FontSize="11"/></DockPanel>
                                </StackPanel>
                            </GroupBox>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                                <Button Content="Process all" Command="{Binding ProcessAllCommand}" FontWeight="SemiBold" Background="#DCE9F8"/>
                                <Button Content="Process selected" Command="{Binding ProcessSelectedCommand}"/>
                                <Button Content="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding CanCancel}"/>
                            </StackPanel>
                            <ProgressBar Height="14" Minimum="0" Maximum="1" Value="{Binding Progress}"/>
                            <TextBlock Text="{Binding ProgressText}" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="#444" FontSize="12"/>
                            <Border Margin="0,4,0,0" Padding="6,4" Background="#FFF4D6" BorderBrush="#E0C068" BorderThickness="1" CornerRadius="3">
                                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding BatchNote}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                <TextBlock Text="{Binding BatchNote}" TextWrapping="Wrap" FontSize="12" Foreground="#6A4A00"/>
                            </Border>
                        </StackPanel>
                        <ListView x:Name="FileList" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" AllowDrop="True" Drop="OnDropFiles" Margin="0,0,0,8" BorderBrush="{StaticResource Border}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Frame" Width="140" DisplayMemberBinding="{Binding Name}"/>
                                    <GridViewColumn Header="Status" Width="84" DisplayMemberBinding="{Binding Status}"/>
                                    <GridViewColumn Header="Power" Width="74" DisplayMemberBinding="{Binding Power}"/>
                                    <GridViewColumn Header="RMS" Width="64" DisplayMemberBinding="{Binding Rms}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>

                    <!-- center: viewer -->
                    <DockPanel Grid.Column="1">
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock Text="Show" Style="{StaticResource Label}"/><ComboBox Width="100" ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" Margin="0,0,10,0"/>
                            <TextBlock Text="Colours" Style="{StaticResource Label}"/><ComboBox Width="95" ItemsSource="{Binding Colormaps}" SelectedItem="{Binding Cmap}" Margin="0,0,10,0"/>
                            <TextBlock Text="OPD unit" Style="{StaticResource Label}"/><ComboBox Width="70" ItemsSource="{Binding UnitChoices}" SelectedItem="{Binding DisplayUnit}" Margin="0,0,10,0"/>
                            <CheckBox Content="auto range" IsChecked="{Binding AutoRange}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Width="78" Text="{Binding VminText}"/><TextBlock Text=" – " VerticalAlignment="Center"/><TextBox Width="78" Text="{Binding VmaxText}"/>
                            <Button Content="Apply" Command="{Binding ApplyRangeCommand}" Margin="6,0,0,0"/>
                        </WrapPanel>
                        <Border DockPanel.Dock="Top" Background="{StaticResource WarnBg}" BorderBrush="#E0B84A" BorderThickness="1" Padding="8,5" Margin="0,0,0,6">
                            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasWarning}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                            <TextBlock Text="{Binding WarningText}" TextWrapping="Wrap" FontSize="12"/>
                        </Border>
                        <c:MapView Spec="{Binding Spec}"/>
                    </DockPanel>

                    <!-- right: results + export -->
                    <ScrollViewer Grid.Column="2" Margin="10,0,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <GroupBox Header="Result">
                                <StackPanel>
                                    <TextBlock Text="{Binding StatsText}" Style="{StaticResource Mono}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding InfoText}" Style="{StaticResource Mono}" TextWrapping="Wrap" Foreground="#555" Margin="0,8,0,0" FontSize="11"/>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="Export">
                                <StackPanel>
                                    <TextBlock Text="Quantities" FontWeight="SemiBold"/>
                                    <WrapPanel>
                                        <CheckBox Content="OPD" IsChecked="{Binding Export.Opd}" Margin="0,2,12,2"/><CheckBox Content="intensity" IsChecked="{Binding Export.Intensity}" Margin="0,2,12,2"/>
                                        <CheckBox Content="mask" IsChecked="{Binding Export.Mask}" Margin="0,2,12,2"/><CheckBox Content="complex field" IsChecked="{Binding Export.Field}" Margin="0,2,12,2"/>
                                    </WrapPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="field as" Style="{StaticResource Label}"/><ComboBox Width="110" ItemsSource="{Binding FieldLayouts}" SelectedItem="{Binding Export.FieldPair}"/></StackPanel>
                                    <TextBlock Text="Formats" FontWeight="SemiBold"/>
                                    <WrapPanel>
                                        <CheckBox Content="matrix .txt/.csv" IsChecked="{Binding Export.MatrixTxt}" Margin="0,2,12,2"/><CheckBox Content="XYZ list" IsChecked="{Binding Export.XyzTxt}" Margin="0,2,12,2"/>
                                        <CheckBox Content="MATLAB .mat" IsChecked="{Binding Export.Mat}" Margin="0,2,12,2"/><CheckBox Content="NumPy .npy" IsChecked="{Binding Export.Npy}" Margin="0,2,12,2"/>
                                        <CheckBox Content="TIFF float32" IsChecked="{Binding Export.Tiff32}" Margin="0,2,12,2"/><CheckBox Content="PNG preview" IsChecked="{Binding Export.Png}" Margin="0,2,12,2"/>
                                    </WrapPanel>
                                    <TextBlock Text="Text matrix / XYZ options" FontWeight="SemiBold" Margin="0,6,0,2"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <TextBlock Text="units" Style="{StaticResource Label}" Margin="0,0,6,4"/><ComboBox Grid.Column="1" ItemsSource="{Binding UnitChoices}" SelectedItem="{Binding ExportUnit}" Margin="0,0,10,4"/>
                                        <TextBlock Grid.Column="2" Text="delimiter" Style="{StaticResource Label}" Margin="0,0,6,4"/><ComboBox Grid.Column="3" ItemsSource="{Binding Delimiters}" SelectedItem="{Binding Export.Matrix.Delim}" Margin="0,0,0,4"/>
                                        <TextBlock Grid.Row="1" Text="decimals" Style="{StaticResource Label}" Margin="0,0,6,0"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Decimals, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="outside" Style="{StaticResource Label}" Margin="0,0,6,0"/>
                                        <ComboBox Grid.Row="1" Grid.Column="3" SelectedIndex="{Binding Export.Matrix.OutsideAsZero, Converter={StaticResource BoolIndex}}"><ComboBoxItem Content="NaN"/><ComboBoxItem Content="0"/></ComboBox>
                                    </Grid>
                                    <CheckBox Content="'#' comment header (λ, pitch, calibration, mode, date)" IsChecked="{Binding Export.Matrix.Header}" Margin="0,6,0,0"/>
                                    <CheckBox Content="XYZ: drop pixels outside the pupil" IsChecked="{Binding Export.XyzDropMasked}"/>
                                    <CheckBox Content="export OPD with the Zernike terms of the Zernike tab removed (recorded in header + sidecar)" IsChecked="{Binding DataContext.Settings.ExportFilteredOpd, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,4,0,0"/>
                                    <TextBlock Text="Output folder" Margin="0,8,0,2" FontWeight="SemiBold"/>
                                    <DockPanel><Button DockPanel.Dock="Right" Content="…" Padding="6,0" Command="{Binding BrowseExportFolderCommand}" Margin="4,0,0,0"/><TextBox Text="{Binding ExportFolder}" ToolTip="default: Documents\QwlsiApp\Output"/></DockPanel>
                                    <CheckBox Content="auto-export every frame during batch (+ summary.csv)" IsChecked="{Binding DataContext.Settings.AutoExportBatch, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,6,0,4"/>
                                    <WrapPanel Margin="0,2,0,0">
                                        <Button Content="Export current" Command="{Binding ExportCurrentCommand}" FontWeight="SemiBold" Background="#DCE9F8" Margin="0,0,6,4"/>
                                        <Button Content="Open folder" Command="{Binding OpenExportFolderCommand}" Margin="0,0,6,4"/>
                                        <Button Content="Summary CSV…" Command="{Binding SaveSummaryCommand}" Margin="0,0,6,4"/>
                                        <Button Content="Save OPD as system wavefront…" Command="{Binding SaveAsSystemWavefrontCommand}" Margin="0,0,6,4"/>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding ExportMessage}" TextWrapping="Wrap" Style="{StaticResource Mono}" FontSize="11" Foreground="#2A6A2A"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ============================================================ ZERNIKE -->
            <TabItem Header="Zernike" FontSize="14">
              <TabControl x:Name="ZernikeSubTabs" FontSize="13" BorderThickness="0" Padding="0">
                <TabItem Header="Single frame">
                <Grid Margin="8" DataContext="{Binding ZernikeVm}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="400"/><ColumnDefinition Width="*"/><ColumnDefinition Width="470"/></Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0" Margin="0,0,10,0">
                        <GroupBox DockPanel.Dock="Top" Header="Terms to remove (OSA/ANSI, order ≤ 10)">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Preset" Style="{StaticResource Label}"/>
                                    <ComboBox Width="150" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"/>
                                    <TextBlock Text="  N =" Style="{StaticResource Label}"/>
                                    <ComboBox Width="55" ItemsSource="{Binding Orders}" SelectedItem="{Binding UpToOrder}"/>
                                </StackPanel>
                                <WrapPanel>
                                    <CheckBox Content="flip x" IsChecked="{Binding FlipX}" Margin="0,2,12,2" ToolTip="default: x to the right"/>
                                    <CheckBox Content="flip y (image rows, y down)" IsChecked="{Binding FlipY}" Margin="0,2,12,2" ToolTip="default: y up (image rows flipped); theta counter-clockwise from +x"/>
                                    <Button Content="Expand" Command="{Binding ExpandAllCommand}" Padding="6,0" MinHeight="20"/><Button Content="Collapse" Command="{Binding CollapseAllCommand}" Padding="6,0" MinHeight="20"/>
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>
                        <TreeView ItemsSource="{Binding Groups}" BorderBrush="{StaticResource Border}">
                            <TreeView.ItemContainerStyle><Style TargetType="TreeViewItem"><Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/></Style></TreeView.ItemContainerStyle>
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type vm:ZGroup}" ItemsSource="{Binding Children}">
                                    <CheckBox IsChecked="{Binding IsChecked}" IsThreeState="True" Content="{Binding Header}" FontWeight="SemiBold"/>
                                </HierarchicalDataTemplate>
                                <DataTemplate DataType="{x:Type vm:ZNode}">
                                    <CheckBox IsChecked="{Binding IsChecked}"><TextBlock Text="{Binding Label}" Style="{StaticResource Mono}"/></CheckBox>
                                </DataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                    </DockPanel>
                    <DockPanel Grid.Column="1">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Show" Style="{StaticResource Label}"/><ComboBox Width="110" ItemsSource="{Binding Views}" SelectedItem="{Binding View}"/>
                            <TextBlock Text="   (the raw result is never modified)" Style="{StaticResource Label}" FontSize="11"/>
                        </StackPanel>
                        <Border DockPanel.Dock="Top" Background="{StaticResource WarnBg}" BorderBrush="#E0B84A" BorderThickness="1" Padding="8,5" Margin="0,0,0,6">
                            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasWarning}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                            <TextBlock Text="{Binding WarningText}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <TextBlock Text="{Binding StatsText}" Style="{StaticResource Mono}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding FitText}" Style="{StaticResource Mono}" TextWrapping="Wrap" Foreground="#555" FontSize="11" Margin="0,6,0,0"/>
                        </StackPanel>
                        <c:MapView Spec="{Binding Spec}"/>
                    </DockPanel>
                    <Grid Grid.Column="2" Margin="10,0,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <GroupBox Header="Coefficients (fit of the raw OPD)" Margin="0,0,0,8">
                            <ListView ItemsSource="{Binding Rows}" FontSize="12" BorderThickness="0">
                                <ListView.View><GridView>
                                    <GridViewColumn Header="j" Width="30" DisplayMemberBinding="{Binding J}"/>
                                    <GridViewColumn Header="Noll" Width="38" DisplayMemberBinding="{Binding Noll}"/>
                                    <GridViewColumn Header="n" Width="26" DisplayMemberBinding="{Binding N}"/>
                                    <GridViewColumn Header="m" Width="28" DisplayMemberBinding="{Binding M}"/>
                                    <GridViewColumn Header="Name" Width="150" DisplayMemberBinding="{Binding Name}"/>
                                    <GridViewColumn Header="c [nm]" Width="68" DisplayMemberBinding="{Binding Nm}"/>
                                    <GridViewColumn Header="[D]" Width="52" DisplayMemberBinding="{Binding Diopters}"/>
                                    <GridViewColumn Header="" Width="70" DisplayMemberBinding="{Binding Removed}"/>
                                </GridView></ListView.View>
                            </ListView>
                        </GroupBox>
                        <GroupBox Grid.Row="1" Header="Export" Margin="0">
                            <StackPanel>
                                <TextBlock Text="Formats" FontWeight="SemiBold"/>
                                <WrapPanel>
                                    <CheckBox Content="matrix .txt/.csv" IsChecked="{Binding Offline.Export.MatrixTxt}" Margin="0,2,12,2"/><CheckBox Content="XYZ list" IsChecked="{Binding Offline.Export.XyzTxt}" Margin="0,2,12,2"/>
                                    <CheckBox Content="MATLAB .mat" IsChecked="{Binding Offline.Export.Mat}" Margin="0,2,12,2"/><CheckBox Content="NumPy .npy" IsChecked="{Binding Offline.Export.Npy}" Margin="0,2,12,2"/>
                                    <CheckBox Content="TIFF float32" IsChecked="{Binding Offline.Export.Tiff32}" Margin="0,2,12,2"/><CheckBox Content="PNG preview" IsChecked="{Binding Offline.Export.Png}" Margin="0,2,12,2"/>
                                </WrapPanel>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="units" Style="{StaticResource Label}" Margin="0,0,6,0"/><ComboBox Grid.Column="1" ItemsSource="{Binding Offline.UnitChoices}" SelectedItem="{Binding Offline.ExportUnit}" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="2" Text="delimiter" Style="{StaticResource Label}" Margin="0,0,6,0"/><ComboBox Grid.Column="3" ItemsSource="{Binding Offline.Delimiters}" SelectedItem="{Binding Offline.Export.Matrix.Delim}"/>
                                </Grid>
                                <CheckBox Content="comment header in text files (the removed terms are always in the sidecar JSON)" IsChecked="{Binding Offline.Export.Matrix.Header}" Margin="0,4,0,0"/>
                                <TextBlock Text="Output folder" Margin="0,6,0,2" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding Offline.ExportFolder}" ToolTip="default: Documents\QwlsiApp\Output (same folder as the Offline tab)"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Export filtered OPD" Command="{Binding ExportFilteredCommand}" FontWeight="SemiBold" Background="#DCE9F8" Margin="0,0,6,4"/>
                                    <Button Content="Export raw OPD" Command="{Binding ExportRawCommand}" Margin="0,0,6,4"/>
                                    <Button Content="Coefficients CSV" Command="{Binding ExportCoefficientsCommand}" Margin="0,0,6,4"/>
                                    <Button Content="Open folder" Command="{Binding OpenExportFolderCommand}" Margin="0,0,6,4"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding ExportMessage}" TextWrapping="Wrap" Style="{StaticResource Mono}" FontSize="11" Foreground="#2A6A2A"/>
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                </Grid>
                </TabItem>

                <!-- ====== all frames ====== -->
                <TabItem Header="All frames">
                <Grid Margin="8" DataContext="{Binding ZernikeAll}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="150"/><RowDefinition Height="250"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,4">
                        <Button Content="Apply selected removal to all frames" Command="{Binding ApplyAllCommand}" FontWeight="SemiBold" Background="#DCE9F8" ToolTip="removes the terms ticked on the 'Single frame' page from every processed frame and fills the table"/>
                        <Button Content="Cancel" Command="{Binding CancelCommand}"/>
                        <Button Content="Export table CSV…" Command="{Binding ExportCsvCommand}"/>
                        <Button Content="Export all filtered maps" Command="{Binding ExportAllFilteredCommand}" ToolTip="writes the filtered OPD of every frame with the matrix / format options below, plus zernike_table.csv"/>
                        <Button Content="Open folder" Command="{Binding OpenExportFolderCommand}"/>
                        <TextBlock Text="  Pupil:" Style="{StaticResource Label}" Margin="12,0,6,0"/>
                        <RadioButton Content="per-frame circle (default)" IsChecked="{Binding CommonCircle, Converter={StaticResource InvBool}}" GroupName="allpupil" Margin="0,0,12,0" VerticalAlignment="Center" ToolTip="each frame's own mask-fitted circle"/>
                        <RadioButton Content="common circle (intersection of all masks)" IsChecked="{Binding CommonCircle}" GroupName="allpupil" VerticalAlignment="Center" ToolTip="one circle fitted to the logical AND of all masks, used for every frame (also by the Video tab's filtered panels)"/>
                    </WrapPanel>
                    <WrapPanel Grid.Row="1" Margin="0,0,0,6">
                        <TextBlock Text="Export:" Style="{StaticResource Label}"/>
                        <CheckBox Content="matrix .txt/.csv" IsChecked="{Binding Offline.Export.MatrixTxt}" Margin="0,2,10,2"/><CheckBox Content="XYZ" IsChecked="{Binding Offline.Export.XyzTxt}" Margin="0,2,10,2"/>
                        <CheckBox Content=".mat" IsChecked="{Binding Offline.Export.Mat}" Margin="0,2,10,2"/><CheckBox Content=".npy" IsChecked="{Binding Offline.Export.Npy}" Margin="0,2,10,2"/>
                        <CheckBox Content="TIFF" IsChecked="{Binding Offline.Export.Tiff32}" Margin="0,2,10,2"/>
                        <TextBlock Text="units" Style="{StaticResource Label}"/><ComboBox Width="62" ItemsSource="{Binding Offline.UnitChoices}" SelectedItem="{Binding Offline.ExportUnit}" Margin="0,0,10,0"/>
                        <TextBlock Text="delimiter" Style="{StaticResource Label}"/><ComboBox Width="72" ItemsSource="{Binding Offline.Delimiters}" SelectedItem="{Binding Offline.Export.Matrix.Delim}" Margin="0,0,10,0"/>
                        <CheckBox Content="# header" IsChecked="{Binding Offline.Export.Matrix.Header}" Margin="0,2,10,2"/>
                        <TextBlock Text="folder" Style="{StaticResource Label}"/><TextBox Width="320" Text="{Binding Offline.ExportFolder}" ToolTip="default: Documents\QwlsiApp\Output"/>
                    </WrapPanel>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="430"/></Grid.ColumnDefinitions>
                        <DataGrid x:Name="AllGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserSortColumns="True" CanUserAddRows="False"
                                  FontSize="12" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E4E4E4" BorderBrush="{StaticResource Border}" ToolTip="click a header to sort; click a row to show that frame's maps below (and in the other tabs)">
                            <DataGrid.RowStyle><Style TargetType="DataGridRow"><Style.Triggers><DataTrigger Binding="{Binding IsSummary}" Value="True"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Background" Value="#EEF1F6"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle>
                        </DataGrid>
                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="130"/></Grid.RowDefinitions>
                            <Border BorderBrush="{StaticResource Border}" BorderThickness="1"><c:TrendPlot x:Name="AllTrend" Series="{Binding TrendSeries}" MarkerFrame="{Binding MarkerFrame}" YLabel="nm"/></Border>
                            <ListBox Grid.Row="1" ItemsSource="{Binding TrendChoices}" FontSize="11" BorderBrush="{StaticResource Border}" Margin="0,4,0,0" ToolTip="tick the quantities of the trend plot">
                                <ListBox.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Name}" Margin="0,1"/></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="3" Margin="0,6,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="{Binding MapsCaption}" Style="{StaticResource Mono}" Margin="0,0,0,2" TextWrapping="Wrap"/>
                        <UniformGrid Grid.Row="1" Rows="1">
                            <DockPanel Margin="0,0,4,0"><TextBlock DockPanel.Dock="Top" Text="original" FontWeight="SemiBold" FontSize="12"/><c:MapView Spec="{Binding OriginalSpec}"/></DockPanel>
                            <DockPanel Margin="0,0,4,0"><TextBlock DockPanel.Dock="Top" Text="removed Zernike surface" FontWeight="SemiBold" FontSize="12"/><c:MapView Spec="{Binding RemovedSpec}"/></DockPanel>
                            <DockPanel><TextBlock DockPanel.Dock="Top" Text="filtered" FontWeight="SemiBold" FontSize="12"/><c:MapView Spec="{Binding FilteredSpec}"/></DockPanel>
                        </UniformGrid>
                    </Grid>
                    <StackPanel Grid.Row="4" Margin="0,6,0,0">
                        <Border Background="{StaticResource WarnBg}" BorderBrush="#E0B84A" BorderThickness="1" Padding="8,4" Margin="0,0,0,4">
                            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsStale}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                            <TextBlock Text="The selection / orientation / pupil option changed after this table was built: press 'Apply selected removal to all frames' to update it." TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                        <ProgressBar Height="12" Minimum="0" Maximum="1" Value="{Binding Progress}"/>
                        <TextBlock Text="{Binding ProgressText}" FontSize="12" Foreground="#444"/>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" Foreground="#2A6A2A"/>
                        <TextBlock Text="{Binding CircleInfo}" TextWrapping="Wrap" FontSize="11" Foreground="#555"/>
                    </StackPanel>
                </Grid>
                </TabItem>
              </TabControl>
            </TabItem>

            <!-- ============================================================ 3D -->
            <TabItem Header="3D" FontSize="14">
                <Grid Margin="8" DataContext="{Binding Surface3D}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ScrollViewer Grid.Column="0" Margin="0,0,10,0" VerticalScrollBarVisibility="Auto"><StackPanel>
                        <GroupBox Header="Surface">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Text="Map" Style="{StaticResource Label}" Margin="0,0,8,4"/><ComboBox Grid.Column="1" ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="1" Text="Mesh" Style="{StaticResource Label}"/><ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Resolutions}" SelectedItem="{Binding Resolution}"/>
                                </Grid>
                                <TextBlock Text="512² / 256² = area-weighted block average of the 1504² map; Full = every pixel (slow)." TextWrapping="Wrap" Foreground="#666" FontSize="11" Margin="0,4,0,0"/>
                                <TextBlock Text="Height exaggeration" Margin="0,8,0,0" FontWeight="SemiBold"/>
                                <Slider Minimum="0" Maximum="5" Value="{Binding ExaggerationLog}" TickFrequency="1"/>
                                <DockPanel><Button DockPanel.Dock="Right" Content="Auto" Command="{Binding AutoExaggerationCommand}" Padding="8,0" MinHeight="20"/><TextBlock Text="{Binding ExaggerationText}" FontSize="11" Foreground="#555" TextWrapping="Wrap"/></DockPanel>
                                <CheckBox Content="wireframe" IsChecked="{Binding Wireframe}" Margin="0,8,0,0"/>
                                <CheckBox Content="axes (mm, nm)" IsChecked="{Binding ShowAxes}"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Colour scale">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Text="Range" Style="{StaticResource Label}" Margin="0,0,8,4"/><ComboBox Grid.Column="1" ItemsSource="{Binding ColorModes}" SelectedItem="{Binding ColorMode}" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="1" Text="Colours" Style="{StaticResource Label}"/><ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Colormaps}" SelectedItem="{Binding Cmap}"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock Text="manual min / max [nm]" Style="{StaticResource Label}"/><TextBox Width="62" Text="{Binding ManualMin, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text=" – " VerticalAlignment="Center"/><TextBox Width="62" Text="{Binding ManualMax, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <TextBlock Text="percentile clip: low / high" Margin="0,6,0,0"/>
                                <StackPanel Orientation="Horizontal"><TextBox Width="50" Text="{Binding PctLo, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text=" % … " VerticalAlignment="Center"/><TextBox Width="50" Text="{Binding PctHi, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text=" %" VerticalAlignment="Center"/></StackPanel>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="View">
                            <StackPanel>
                                <WrapPanel>
                                    <Button Content="Isometric" Command="{Binding SetViewCommand}" CommandParameter="Isometric"/><Button Content="Top" Command="{Binding SetViewCommand}" CommandParameter="Top"/>
                                    <Button Content="Front" Command="{Binding SetViewCommand}" CommandParameter="Front"/><Button Content="Side" Command="{Binding SetViewCommand}" CommandParameter="Side"/>
                                    <Button Content="Back" Command="{Binding SetViewCommand}" CommandParameter="Back"/>
                                </WrapPanel>
                                <TextBlock Text="mouse: left-drag rotate, right-drag pan, wheel zoom" Foreground="#666" FontSize="11" Margin="0,4,0,0"/>
                                <CheckBox Content="software rendering (WARP)" IsChecked="{Binding Software}" Margin="0,8,0,0" ToolTip="use if the GPU / driver cannot render the 3-D view; switches automatically on a render failure"/>
                                <Button Content="Save PNG screenshot…" Command="{Binding ScreenshotCommand}" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </GroupBox>
                        <TextBlock Text="{Binding Info}" Style="{StaticResource Mono}" FontSize="11" Foreground="#555" TextWrapping="Wrap"/>
                    </StackPanel></ScrollViewer>
                    <c:Surface3DView x:Name="View3D" Grid.Column="1"/>
                </Grid>
            </TabItem>

            <!-- ============================================================ VIDEO -->
            <TabItem Header="Video" FontSize="14">
                <Grid Margin="8" DataContext="{Binding Video}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="400"/><ColumnDefinition Width="*"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
                    <ScrollViewer Grid.Column="0" Margin="0,0,10,0" VerticalScrollBarVisibility="Auto"><StackPanel>
                        <GroupBox Header="Frames (processed rows of the Offline list)">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Order" Style="{StaticResource Label}"/><ComboBox Width="150" ItemsSource="{Binding Orders}" SelectedItem="{Binding Order}"/>
                                    <TextBlock Text="  range" Style="{StaticResource Label}"/><TextBox Width="42" Text="{Binding FirstFrame, UpdateSourceTrigger=PropertyChanged}" ToolTip="first frame (1-based)"/>
                                    <TextBlock Text=" … " VerticalAlignment="Center"/><TextBox Width="42" Text="{Binding LastFrame, UpdateSourceTrigger=PropertyChanged}" ToolTip="last frame (0 = to the end)"/>
                                    <Button Content="↻" Command="{Binding RefreshFramesCommand}" Padding="6,0" Margin="6,0,0,0" ToolTip="update the frame count"/>
                                </StackPanel>
                                <TextBlock Text="{Binding FramesText}" Foreground="#555" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Panels (1 = full, 2 = side by side, 3 = first on top, 4 = 2 × 2)">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="Panel 1" Style="{StaticResource Label}"/><ComboBox Grid.Column="1" ItemsSource="{Binding PanelChoices}" SelectedItem="{Binding Panel1}" Margin="0,0,0,3"/>
                                <TextBlock Grid.Row="1" Text="Panel 2" Style="{StaticResource Label}"/><ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding OptionalPanelChoices}" SelectedItem="{Binding Panel2}" Margin="0,0,0,3"/>
                                <TextBlock Grid.Row="2" Text="Panel 3" Style="{StaticResource Label}"/><ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding OptionalPanelChoices}" SelectedItem="{Binding Panel3}" Margin="0,0,0,3"/>
                                <TextBlock Grid.Row="3" Text="Panel 4" Style="{StaticResource Label}"/><ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding OptionalPanelChoices}" SelectedItem="{Binding Panel4}"/>
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="Colour">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Text="Colormap" Style="{StaticResource Label}"/><ComboBox Grid.Column="1" ItemsSource="{Binding Colormaps}" SelectedItem="{Binding Cmap}" Margin="0,0,0,3"/>
                                    <TextBlock Grid.Row="1" Text="Range" Style="{StaticResource Label}"/><ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding RangeModes}" SelectedItem="{Binding Range}" Margin="0,0,0,3"/>
                                    <TextBlock Grid.Row="2" Text="Units" Style="{StaticResource Label}"/><ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding UnitChoices}" SelectedItem="{Binding Unit}"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock Text="percentiles (clipped mode)" Style="{StaticResource Label}"/><TextBox Width="42" Text="{Binding PctLo, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text=" … " VerticalAlignment="Center"/><TextBox Width="42" Text="{Binding PctHi, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text=" %" VerticalAlignment="Center"/></StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"><CheckBox Content="manual fixed range (display unit)" IsChecked="{Binding ManualRange}" VerticalAlignment="Center"/><TextBox Width="55" Margin="6,0,0,0" Text="{Binding ManualMin, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text=" … " VerticalAlignment="Center"/><TextBox Width="55" Text="{Binding ManualMax, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <CheckBox Content="colourbar" IsChecked="{Binding Colorbar}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Overlays">
                            <StackPanel>
                                <CheckBox Content="frame name and number" IsChecked="{Binding OverlayName}"/>
                                <CheckBox Content="power, rms and PV" IsChecked="{Binding OverlayStats}"/>
                                <CheckBox Content="strip plot of a value against the frame number (moving marker)" IsChecked="{Binding StripPlot}"/>
                                <StackPanel Orientation="Horizontal" Margin="18,2,0,0"><ComboBox Width="150" ItemsSource="{Binding StripValues}" SelectedItem="{Binding StripValue}"/><ComboBox Width="170" Margin="6,0,0,0" ItemsSource="{Binding StripTerms}" SelectedItem="{Binding StripTerm}" ToolTip="Zernike term (when 'Zernike term' is chosen)"/></StackPanel>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="3D surface and turntable">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Text="Mesh" Style="{StaticResource Label}"/><ComboBox Grid.Column="1" ItemsSource="{Binding Meshes}" SelectedItem="{Binding Mesh}" Margin="0,0,0,3"/>
                                    <TextBlock Grid.Row="1" Text="Elevation" Style="{StaticResource Label}"/><Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="90" Value="{Binding Elevation}" ToolTip="fixed during a turntable"/>
                                    <TextBlock Grid.Row="2" Text="Azimuth" Style="{StaticResource Label}"/><Slider Grid.Row="2" Grid.Column="1" Minimum="-180" Maximum="180" Value="{Binding Azimuth}" ToolTip="start azimuth of a turntable"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"><CheckBox Content="auto height exaggeration" IsChecked="{Binding ExaggerationAuto}" VerticalAlignment="Center"/><TextBox Width="60" Margin="6,0,0,0" Text="{Binding Exaggeration, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ExaggerationAuto, Converter={StaticResource InvBool}}"/></StackPanel>
                                <CheckBox Content="axes (mm, nm)" IsChecked="{Binding Axes}"/>
                                <CheckBox Content="3D shows the Zernike-filtered OPD" IsChecked="{Binding SurfaceFiltered}"/>
                                <CheckBox Content="turntable: rotate ONE frame's 3D surface through 360°" IsChecked="{Binding Turntable}" Margin="0,8,0,0" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Margin="18,2,0,0"><TextBlock Text="over" Style="{StaticResource Label}"/><TextBox Width="45" Text="{Binding TurntableSeconds, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text=" s   frame no." Style="{StaticResource Label}" Margin="6,0,6,0"/><TextBox Width="45" Text="{Binding TurntableFrame, UpdateSourceTrigger=PropertyChanged}" ToolTip="position in the chosen frame range (1-based)"/></StackPanel>
                                <TextBlock Text="needs a '3D surface' panel; the turntable replaces the frame sequence" Foreground="#666" FontSize="11" Margin="18,2,0,0"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel></ScrollViewer>

                    <DockPanel Grid.Column="1" Margin="0,0,10,0">
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <DockPanel><Button DockPanel.Dock="Right" Content="Preview" Command="{Binding PreviewCommand}" Margin="6,0,0,0"/><Slider Minimum="1" Maximum="{Binding PreviewMax}" Value="{Binding PreviewIndex}" IsSnapToTickEnabled="True" TickFrequency="1" ToolTip="frame (or turntable step) to preview"/></DockPanel>
                            <TextBlock Text="{Binding PreviewInfo}" Style="{StaticResource Mono}" Foreground="#555"/>
                        </StackPanel>
                        <Border Background="#202020" BorderBrush="{StaticResource Border}" BorderThickness="1"><Image Source="{Binding PreviewImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/></Border>
                    </DockPanel>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel>
                        <GroupBox Header="Output">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Text="Format" Style="{StaticResource Label}"/><ComboBox Grid.Column="1" ItemsSource="{Binding Formats}" SelectedItem="{Binding Format}" Margin="0,0,0,3"/>
                                    <TextBlock Grid.Row="1" Text="Size" Style="{StaticResource Label}"/><ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Resolutions}" SelectedItem="{Binding Resolution}" Margin="0,0,0,3"/>
                                    <TextBlock Grid.Row="2" Text="Frames / s" Style="{StaticResource Label}"/><DockPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,3"><TextBox DockPanel.Dock="Right" Width="38" Margin="6,0,0,0" Text="{Binding Fps, UpdateSourceTrigger=PropertyChanged}"/><Slider Minimum="1" Maximum="60" Value="{Binding Fps}" IsSnapToTickEnabled="True" TickFrequency="1"/></DockPanel>
                                    <TextBlock Grid.Row="3" Text="Blend" Style="{StaticResource Label}"/><StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal"><TextBox Width="38" Text="{Binding BlendSteps, UpdateSourceTrigger=PropertyChanged}" ToolTip="0 = no blending between frames (default); n = n cross-faded frames between consecutive frames"/><TextBlock Text="  cross-fade frames between frames (0 = none)" Foreground="#666" FontSize="11" VerticalAlignment="Center"/></StackPanel>
                                </Grid>
                                <TextBlock Text="File (empty = output folder, automatic name)" Margin="0,6,0,2" FontSize="12"/>
                                <DockPanel><Button DockPanel.Dock="Right" Content="…" Padding="6,0" Command="{Binding BrowseOutputCommand}" Margin="4,0,0,0"/><TextBox Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                                <TextBlock Text="{Binding Estimate}" Margin="0,6,0,0" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#2F6DB5"/>
                            </StackPanel>
                        </GroupBox>
                        <WrapPanel Margin="0,0,0,6">
                            <Button Content="Render video" Command="{Binding RenderCommand}" FontWeight="SemiBold" Background="#DCE9F8"/>
                            <Button Content="Cancel" Command="{Binding CancelCommand}"/>
                            <Button Content="Show file" Command="{Binding OpenOutputCommand}"/>
                        </WrapPanel>
                        <ProgressBar Height="14" Minimum="0" Maximum="1" Value="{Binding Progress}"/>
                        <TextBlock Text="{Binding ProgressText}" TextWrapping="Wrap" FontSize="12" Foreground="#444" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" Foreground="#2A6A2A" Margin="0,6,0,0"/>
                        <GroupBox Header="ffmpeg" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding FfmpegStatus}" TextWrapping="Wrap" FontSize="11" Foreground="#555"/>
                                <Button Content="Use another ffmpeg.exe…" Command="{Binding BrowseFfmpegCommand}" Margin="0,6,0,0" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel></ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ============================================================ CALIBRATION -->
            <TabItem Header="Calibration" FontSize="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="12" DataContext="{Binding CalibrationVm}" MaxWidth="1100" HorizontalAlignment="Left">
                    <StackPanel>
                        <GroupBox Header="Loaded calibration">
                            <StackPanel>
                                <TextBlock Text="{Binding DataContext.CalibrationText, RelativeSource={RelativeSource AncestorType=Window}}" TextWrapping="Wrap" Style="{StaticResource Mono}" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <Button Content="Browse…" Command="{Binding BrowseCommand}"/>
                                    <Button Content="Auto-find" Command="{Binding AutoFindCommand}"/>
                                    <Button Content="Save as calibration.json…" Command="{Binding SaveCandidateCommand}"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding SearchLog}" Style="{StaticResource Mono}" Foreground="#555" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11"/>
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#555" FontSize="12"
                                           Text="calibration.json holds the two carrier vectors (cyc/px). It stays valid for any sample as long as grating, camera, relay and binning are unchanged. A carrier error is indistinguishable from defocus/astigmatism, so never use nominal carriers."/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Make a calibration from a flat / collimated frame">
                            <StackPanel>
                                <ListBox ItemsSource="{Binding FlatFiles}" Height="80" FontSize="12"/>
                                <WrapPanel Margin="0,6,0,0">
                                    <Button Content="Add flat frame(s)…" Command="{Binding AddFlatFilesCommand}"/>
                                    <Button Content="Clear" Command="{Binding ClearFlatFilesCommand}"/>
                                    <CheckBox Content="average all listed frames" IsChecked="{Binding AverageFrames}" VerticalAlignment="Center" Margin="6,0,12,0"/>
                                    <Button Content="Calibrate" Command="{Binding CalibrateCommand}" FontWeight="SemiBold" Background="#DCE9F8"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding ProgressText}" Foreground="#555" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding NewCarriers}" Style="{StaticResource Mono}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Diagnostics}" Style="{StaticResource Mono}" Foreground="#555" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <WrapPanel Margin="0,6,0,0"><Button Content="Use this calibration" Command="{Binding UseCandidateCommand}" IsEnabled="{Binding HasCandidate}"/>
                                    <Button Content="Save as calibration.json…" Command="{Binding SaveCandidateCommand}" IsEnabled="{Binding HasCandidate}"/></WrapPanel>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Check the loaded calibration on a flat frame">
                            <StackPanel>
                                <Button Content="Process a flat frame…" Command="{Binding CheckOnFlatCommand}" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding CheckResult}" Style="{StaticResource Mono}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </Grid></ScrollViewer>
            </TabItem>

            <!-- ============================================================ SETTINGS -->
            <TabItem Header="Settings" FontSize="14">
                <Grid Margin="12" DataContext="{Binding SettingsVm}" HorizontalAlignment="Left" MaxWidth="700">
                    <StackPanel>
                        <GroupBox Header="System parameters (saved in %APPDATA%\QwlsiApp\settings.json)">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="Cross-grating period Γ" Style="{StaticResource Label}" Margin="0,4"/><TextBox Grid.Column="1" Text="{Binding GammaUm}" Margin="0,3"/><TextBlock Grid.Column="2" Text=" µm" Style="{StaticResource Label}"/>
                                <TextBlock Grid.Row="1" Text="Grating – camera distance d" Style="{StaticResource Label}" Margin="0,4"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DMm}" Margin="0,3"/><TextBlock Grid.Row="1" Grid.Column="2" Text=" mm" Style="{StaticResource Label}"/>
                                <TextBlock Grid.Row="2" Text="Pixel size p" Style="{StaticResource Label}" Margin="0,4"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PUm}" Margin="0,3"/><TextBlock Grid.Row="2" Grid.Column="2" Text=" µm" Style="{StaticResource Label}"/>
                                <TextBlock Grid.Row="3" Text="Relay zoom Z" Style="{StaticResource Label}" Margin="0,4"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Zoom}" Margin="0,3"/>
                                <TextBlock Grid.Row="4" Text="Wavelength λ" Style="{StaticResource Label}" Margin="0,4" FontWeight="SemiBold"/><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding LambdaNm}" Margin="0,3"/><TextBlock Grid.Row="4" Grid.Column="2" Text=" nm  (default 650)" Style="{StaticResource Label}"/>
                                <TextBlock Grid.Row="5" Text="Spectral window radius R" Style="{StaticResource Label}" Margin="0,4"/><TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Radius}" Margin="0,3"/><TextBlock Grid.Row="5" Grid.Column="2" Text=" bins" Style="{StaticResource Label}"/>
                                <TextBlock Grid.Row="6" Text="Decimation" Style="{StaticResource Label}" Margin="0,4"/><TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Decimation}" Margin="0,3"/>
                                <TextBlock Grid.Row="7" Text="Sensor size (default; frames set their own)" Style="{StaticResource Label}" Margin="0,4"/><TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Sensor}" Margin="0,3"/><TextBlock Grid.Row="7" Grid.Column="2" Text=" px" Style="{StaticResource Label}"/>
                            </Grid>
                        </GroupBox>
                        <WrapPanel><Button Content="Save" Command="{Binding ApplyCommand}" FontWeight="SemiBold" Background="#DCE9F8"/><Button Content="Restore defaults" Command="{Binding ResetDefaultsCommand}"/></WrapPanel>
                        <TextBlock Text="{Binding Message}" Margin="0,8,0,0" Foreground="#2A6A2A" TextWrapping="Wrap"/>
                        <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Foreground="#555" FontSize="12"
                                   Text="Changing λ: the shear scales with λ while the measured phase scales with 1/λ, so the reconstructed OPD is almost independent of this setting (+5 % in λ changes the OPD by &lt;1 nm). λ is used for the complex-field phase 2π·OPD/λ and in the exports. For another wavelength also re-check the calibration on a flat frame (should read 0.00 D) and make a new system wavefront from a flat frame."/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ============================================================ HELP -->
            <TabItem Header="Help" FontSize="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16" MaxWidth="900" HorizontalAlignment="Left">
                    <TextBlock Text="What this app does" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" Text="It reconstructs the wavefront (OPD and complex field) from ONE raw QWLSI frame. The two shear interferograms are demodulated from the carrier peaks of the frame spectrum; the OPD is found by a masked least-squares inversion with the exact shear operator (Fourier-preconditioned conjugate gradient, 60 iterations × 3 passes). Intensity comes from the zero-order lobe." Margin="0,0,0,12"/>
                    <TextBlock Text="Without reference / with reference" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Text="WITHOUT a reference the OPD includes the static system/beam wavefront (about 0.3–0.4 µm rms). Subtracting a system wavefront (an OPD made from a flat frame, e.g. ref_OPD_m.npy) reproduces reference-based results to about 5 nm. WITH a reference (a flat frame), the sample lobes are divided by the reference lobes and the carriers are detected from the reference, giving the sample-only OPD."/>
                    <TextBlock Text="Calibration" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Text="A carrier-vector error is mathematically identical to defocus/astigmatism, so the carriers must come from a one-time calibration on a flat/collimated frame (Calibration tab). calibration.json is valid for any sample as long as grating, camera, relay and binning are unchanged, and is the same file the Python/MATLAB tools use. Auto-find order: folder of the loaded image → app folder → last-used path → %APPDATA%\QwlsiApp."/>
                    <TextBlock Text="Wavelength" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Text="For a wavelength other than 650 nm set λ in Settings (the shear scales with λ). Re-check a flat frame (should read 0.00 D) and make a new flat-based system wavefront."/>
                    <TextBlock Text="Conventions" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Text="Lens power from the Zernike defocus: + = concave (bowl). Piston and tilt are removed (tilt is not absolute in a single frame). The result grid is 1504 × 1504 at 3 px = 8.22 µm pitch. Outside the pupil the OPD is NaN (or 0 if chosen for the export)."/>
                    <TextBlock Text="Exports" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Text="Matrix .txt/.csv: one image row per line, loadable with MATLAB readmatrix / numpy loadtxt. Defaults: nm, tab, 3 decimals, NaN outside, no header. XYZ list: x_mm, y_mm, OPD (origin = pupil centroid). .mat (v5), .npy (OPD in metres, complex64 field) and float32 TIFF are also available. A sidecar *_export.json records every parameter used."/>
                    <TextBlock Text="Video tab" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Text="Renders the processed frames of the Offline list into an MP4 (H.264, bundled LGPL ffmpeg), GIF, AVI (MJPEG) or PNG sequence: up to four panels (OPD, filtered OPD, removed Zernike surface, intensity, wrapped phase, raw frame, 3D surface), a colour range fixed across all frames by default, overlays, a strip plot and a 3D turntable. Use Preview to see a frame exactly as it will appear. Without ffmpeg, MP4 is saved as AVI. See the user guide, section 8."/>
                    <TextBlock Text="Zernike, all frames" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Text="Zernike tab, page 'All frames': the selected removal applied to every processed frame, one table row per frame (terms in nm, power, astigmatism magnitude and axis, rms/PV before and after), sortable, with mean / std, CSV export, trend plot, per-frame maps and 'Export all filtered maps'. The pupil can be each frame's own circle (default) or one common circle fitted to the intersection of all masks."/>
                </StackPanel></ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="10,4">
            <Grid>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Grid.RowSpan="2" Grid.Column="2" Content="About / diagnostics" Click="OnAbout" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding CalibrationText}" Style="{StaticResource Mono}" FontSize="11" TextTrimming="CharacterEllipsis" Grid.ColumnSpan="2"/>
                <DockPanel Grid.Row="1">
                    <ProgressBar DockPanel.Dock="Right" Width="150" Height="12" Minimum="0" Maximum="1" Value="{Binding Offline.Progress, Mode=OneWay}" Margin="8,0,12,0" ToolTip="recomputing a result that is no longer cached">
                        <ProgressBar.Visibility><Binding Path="Offline.IsRecomputing"><Binding.Converter><BooleanToVisibilityConverter/></Binding.Converter></Binding></ProgressBar.Visibility>
                    </ProgressBar>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MemoryText}" Style="{StaticResource Mono}" FontSize="11" Foreground="#555"/>
            </Grid>
        </Border>
    </Grid>
</Window>
