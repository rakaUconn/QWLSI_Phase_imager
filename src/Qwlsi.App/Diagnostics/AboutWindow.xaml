<Window x:Class="Qwlsi.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About QWLSI single-frame wavefront" Width="980" Height="720" MinWidth="700" MinHeight="450" WindowStartupLocation="CenterOwner" Background="White">
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,10">
            <TextBlock x:Name="Title1" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="Sub" Foreground="#555" Margin="0,2,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <TextBox x:Name="Report" Grid.Row="1" IsReadOnly="True" FontFamily="Consolas" FontSize="12" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" BorderBrush="{StaticResource Border}"/>
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Close" IsCancel="True" IsDefault="True" Padding="18,4" Margin="0"/></StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Content="Copy diagnostics" Click="OnCopy" FontWeight="SemiBold" Background="#DCE9F8"/>
                <Button Content="Refresh" Click="OnRefresh"/>
                <Button Content="Open log folder" Click="OnOpenLogs"/>
                <TextBlock x:Name="Note" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#2A6A2A"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
